# Copy this file to .env.production on the VPS and replace every placeholder.
# Never commit .env.production (or any other .env file).
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# The canonical public URL, including https:// and without a trailing slash.
NEXT_PUBLIC_APP_URL=https://rankings.example.com

# Clerk production instance keys. Generate these in the production Clerk instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/rank
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/rank

# PostgreSQL used by the server-side persistence layer.
DATABASE_URL=postgresql://tier_bench:replace_me@127.0.0.1:5432/tier_bench?sslmode=disable

# The public OpenRouter catalog endpoint does not require an API key.
OPENROUTER_CATALOG_SYNC_ENABLED=false

# Optional bot protection / scheduled-job credentials.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_me
TURNSTILE_SECRET_KEY=replace_me
CRON_SECRET=replace_me
